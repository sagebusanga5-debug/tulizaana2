{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm install && prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --external:crypto --external:fs --external:path",
    "start": "node dist/server.cjs",
    "postinstall": "prisma generate",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:auth": "tsx scripts/test-google-auth-security.ts",
    "test:admin-security": "tsx scripts/test-admin-security.ts",
    "test:partner-security": "tsx scripts/test-partner-security.ts",
    "test:resource-security": "tsx scripts/test-resource-security.ts",
    "test:storage-security": "tsx scripts/test-storage-security.ts",
    "test:api-integrity": "tsx scripts/test-api-integrity.ts",
    "test:public-profiles": "tsx scripts/test-public-profiles.ts",
    "test:auth-cookie-security": "tsx scripts/test-auth-cookie-security.ts",
    "test:seed": "tsx scripts/test-seed-credentials.ts",
    "test:global-search": "tsx scripts/test-global-search.ts",
    "test:partner-reports": "tsx scripts/test-partner-reports.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:test": "tsx scripts/test-db-connection.ts",
    "db:seed": "prisma db seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prisma": "^6.4.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
