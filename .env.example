# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES POSTGRESQL (Générées automatiquement par l'intégration Vercel-Supabase)
# ------------------------------------------------------------------------------
# Chaîne de connexion poolée recommandée pour Prisma :
POSTGRES_PRISMA_URL="postgresql://postgres.zrpmbsknudinjjryjinm:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15&sslmode=verify-full&sslrootcert=certs/supabase.crt"

# Chaîne de connexion standard Vercel :
POSTGRES_URL="postgresql://postgres.zrpmbsknudinjjryjinm:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=verify-full&sslrootcert=certs/supabase.crt"

# Connexion directe sans pooling (utile pour les migrations Prisma) :
POSTGRES_URL_NON_POOLING="postgresql://postgres.zrpmbsknudinjjryjinm:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase.crt"

# Paramètres individuels PostgreSQL :
POSTGRES_USER="postgres.zrpmbsknudinjjryjinm"
POSTGRES_HOST="aws-1-eu-west-1.pooler.supabase.com"
POSTGRES_PASSWORD="[YOUR-PASSWORD]"
POSTGRES_DATABASE="postgres"

# (Optionnel : standard Prisma si vous n'utilisez pas POSTGRES_PRISMA_URL)
# --- Chiffrement PostgreSQL verifie (Chantier 7.5) ---
# CA officielle Supabase : certs/supabase.crt  (racine publique "Supabase Root 2021 CA")
# sslmode=verify-full    -> validation de la chaine de certificats ET du hostname
# sslrootcert            -> chemin relatif a la racine du projet (lancer Prisma depuis la racine)
# Ne jamais remplacer par sslmode=require / rejectUnauthorized=false : cela desactive la validation.
# ----------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.zrpmbsknudinjjryjinm:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=verify-full&sslrootcert=certs/supabase.crt"
DIRECT_URL="postgresql://postgres.zrpmbsknudinjjryjinm:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?pgbouncer=false&sslmode=verify-full&sslrootcert=certs/supabase.crt"

