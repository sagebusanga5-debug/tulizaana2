# ------------------------------------------------------------------------------
# 5. GOOGLE / FIREBASE AUTH (verification serveur des ID tokens)
# ------------------------------------------------------------------------------
# Principe : le backend ne fait AUCUNE confiance au corps de la requete.
# Seul un Firebase ID token verifie par firebase-admin prouve l'identite.
#
# Firebase est utilise dans Tulizaana uniquement pour l'authentification Google.
#
# Méthode A (recommandée sur Vercel / cPanel) : variables explicites.
# Valeurs trouvables dans Firebase Console > Paramètres du projet > Vos applications.
# La clé privée est celle du JSON de clé de compte de service.
# NE JAMAIS committer ces valeurs : les saisir dans les variables d'environnement
# de l'hébergeur. Les retours à la ligne "\n" de la clé privée sont acceptés.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Méthode B : un seul JSON complet (pratique avec les secret managers).
# FIREBASE_CONFIG='{"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}'

# Méthode C : Application Default Credentials de l'hébergeur.
# GOOGLE_APPLICATION_CREDENTIALS="/chemin/vers/service-account.json"
#
# Si aucune de ces trois méthodes n'est configurée, POST /api/auth/google
# répond 503 et la connexion Google est indisponible. La connexion par
# email/mot de passe (/api/auth/login) reste pleinement fonctionnelle.

# ------------------------------------------------------------------------------
# 6. SÉCURITÉ DE SESSION
# ------------------------------------------------------------------------------
# OBLIGATOIRE. Le serveur refuse de démarrer si cette variable est absente ou
# si elle fait moins de 32 caractères. Aucun secret par défaut n'existe.
# Générer une valeur aléatoire (à faire une seule fois, puis à conserver) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=3000

# ------------------------------------------------------------------------------
# 8. COMPTES DE DÉMONSTRATION (seed uniquement)
# ------------------------------------------------------------------------------
# LUES UNIQUEMENT par `prisma/seed.ts`, au moment du peuplement de la base.
# Elles ne sont lues par aucun endpoint, aucun composant, et ne doivent jamais
# être préfixées par VITE_ : le frontend ne doit pas y avoir accès.
#
# Règles :
#   - laisser ces variables VIDES désactive la création des comptes de
#     démonstration (avertissement explicite, aucun compte sans secret) ;
#   - les renseigner toutes crée les trois comptes, avec des mots de passe
#     hashés en bcrypt avant insertion ;
#   - n'en renseigner qu'une partie interrompt le seed : ce n'est pas une
#     erreur de frappe silencieuse ;
#   - 12 caractères minimum par valeur.
#
# Correspondance avec le rôle réel stocké en base (`User.role`) :
#   DEMO_PARTNER_ADMIN_PASSWORD → coordination@panzi-tulizaana.org (partner_admin)
#   DEMO_PEER_HELPER_PASSWORD   → amina.drepa@tulizaana.cd     (peer_helper)
#   DEMO_MEMBER_PASSWORD        → jean.marc@tulizaana.cd      (member)
#
# Ne jamais écrire de valeur réelle dans ce fichier : il est versionné.
ADMIN_SEED_PASSWORD=""
DEMO_PARTNER_ADMIN_PASSWORD=""
DEMO_PEER_HELPER_PASSWORD=""
DEMO_MEMBER_PASSWORD=""

# ------------------------------------------------------------------------------
# 9. FONCTIONS IA (optionnel)
# ------------------------------------------------------------------------------
# Sans cette cle, la traduction et les analyses d'humeur basculent en mode
# repli local. Aucune autre fonctionnalite n'est impactee.
GEMINI_API_KEY=""
